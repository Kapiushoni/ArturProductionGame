{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,

    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
